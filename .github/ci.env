# Fixture configuration used by the CI workflow.
#
# The merge gate must not depend on the AWS account of whoever opened the pull
# request, so the tests and the "cdk synth" run against these values instead of
# the repository configuration. They are deliberately fake: nothing here is
# deployed, synthesizing only turns the code into a CloudFormation template.
#
# Add a key here whenever the stack starts requiring one, or the synth step
# stops covering it.
awsRegion=eu-west-3
awsAccountId=111122223333
stackName=ReactCdkBaseProjectStack
bucketName=ci-synth-check-bucket
notificationEmail=ci@example.com
budgetFirstNotificationLimit=50
budgetStopServiceLimit=100
budgetName=ci-budget
restApiName=ci-api
snsTopicName=ci-budget-topic
tagName=ci-project
apiProdBasePath=api
openApiExportType=yaml
apiKeyName=ci-api-key
apiKeyQuota=1000
apiKeyRateLimit=5
apyKeyBurstLimit=5
appDeployedOnce=true
createCognito=false
createGoogleLogin=false
createDnsRecord=false
deployWebsiteWithCdk=true
websiteBuildPath=../resources/react-website/build
websiteDistPath=resources/react-website/build
