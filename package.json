{
  "name": "react-cdk-base-project",
  "version": "0.1.0",
  "bin": {
    "react-cdk-base-project": "bin/react-cdk-base-project.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:lambdas": "jest resources/lambdas/test",
    "cdkDeploy": "cdk deploy --require-approval never --profile proyectoCDK",
    "myscripts": "pip install -r ./resources/lambdas/requirements.txt -t ./resources/lambdas && cd resources/react-website && npm run build && cd ../../",
    "mydeploy": "npm run myscripts && cdk deploy --require-approval never --profile proyectoCDK",
    "mysynth": "npm run build && cdk synth"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "aws-cdk": "2.1139.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.267.0",
    "constructs": "^10.5.0",
    "dotenv": "^17.4.2"
  }
}
