# ---------------------------------------------------------------------------
# Template for the local .env file.
#
#   npm run setup      -> copies this file to .env (and installs dependencies)
#   npm run check:env  -> verifies the values below are present before deploying
#
# The .env file is git-ignored on purpose: it holds account-specific values.
# In GitHub Actions the very same keys are provided as repository
# variables/secrets (see the "Deploying from GitHub Actions" section of the
# README), so nothing here needs to be committed.
# ---------------------------------------------------------------------------

# --- AWS account / CLI ---
# Local AWS CLI profile used by every npm deploy script. Leave it empty when
# credentials come from the environment (this is what GitHub Actions does).
awsProfile=proyectoCDK
# Region to deploy to. Required for CloudFront + Route 53 lookups.
awsRegion=eu-west-3
# Account id. Optional: falls back to the account of the current credentials.
awsAccountId=
# CloudFormation stack name. Changing it after the first deploy creates a
# brand new stack, so only touch it before your first deploy.
stackName=ReactCdkBaseProjectStack

# --- Your variables ---
bucketName=lekimlarra-test-your-bucket-name-here
httpCertificate=arn:aws:acm:us-east-1:ACCOUNT:certificate/UUID
yourDomain=https://your-custom-url.com
notificationEmail=your-email@gmail.com
budgetFirstNotificationLimit=50
budgetStopServiceLimit=100
budgetName=cdk-react-budget
restApiName=cdk-template-api

# --- Custom domain (optional) ---
# Comma separated list of domains served by the CloudFront distribution.
# Requires httpCertificate to be an ACM certificate issued in us-east-1.
customDomainNames=
# Route 53 hosted zone to create the alias record in, e.g. "example.com".
hostedZoneDomain=
# Sub-domain for the alias record. Empty means the zone apex.
dnsRecordName=
# Set to "true" to create the Route 53 A record pointing at CloudFront.
createDnsRecord=false

# --- Cognito ---
createCognito=false
userPoolName=Pool-name
userPoolClientName=Pool-client-name
cognitoCallBackPath=/auth/callback
logoutPath=/

# --- Website deployment ---
# "true"  -> the website is uploaded by the CDK stack (BucketDeployment).
# "false" -> the stack only creates the bucket; upload with "npm run s3deploy".
#            Use this for large sites: it is much faster and lets you deploy
#            website content without touching the infrastructure.
deployWebsiteWithCdk=true
# Path to the built website, relative to lib/ (used by the CDK stack).
websiteBuildPath=../resources/react-website/build
# Path to the built website, relative to the repo root (used by "npm run s3deploy").
websiteDistPath=resources/react-website/build
# Optional: skips a CloudFormation lookup when invalidating the CDN cache.
cloudFrontDistributionId=

# --- Default variables ---
lambdasPath=../resources/lambdas
databasePath=../resources/databases
tagName=react-cdk-base-project
snsTopicName=budget-topic-name
apiProdBasePath=api
openApiExportType=yaml

# --- API key ---
apiKeyName=apiKeyNameCDKProject
apiKeyQuota=1000
apiKeyRateLimit=5
apyKeyBurstLimit=5

# --- Single time creation tags ---
# The budget can only be created once: set this to "true" after the first deploy.
appDeployedOnce=true
